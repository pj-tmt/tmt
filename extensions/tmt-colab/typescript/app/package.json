    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "^1.34.0",
    "prettier": "^3.7.4",
    "typescript": "^5.3.0",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  }
}
