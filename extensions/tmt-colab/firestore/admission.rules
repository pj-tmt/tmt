    && (request.resource.data.quotaBytes == 256)
    && ((request.method == 'create' ? request.resource.data.quotaUid == request.auth.uid : request.resource.data.quotaUid == resource.data.quotaUid))
    && ((ext.getAfter(/uid-budgets/$(request.resource.data.space + '_' + request.auth.uid)).data.actor == request.auth.uid && ext.getAfter(/uid-budgets/$(request.resource.data.space + '_' + request.auth.uid)).data.targetKind == 'spaces' && ext.getAfter(/uid-budgets/$(request.resource.data.space + '_' + request.auth.uid)).data.targetId == space && ext.getAfter(/uid-budgets/$(request.resource.data.space + '_' + request.auth.uid)).data.action == request.method)
    && (ext.getAfter(/space-budgets/$(request.resource.data.space)).data.actor == request.auth.uid && ext.getAfter(/space-budgets/$(request.resource.data.space)).data.targetKind == 'spaces' && ext.getAfter(/space-budgets/$(request.resource.data.space)).data.targetId == space && ext.getAfter(/space-budgets/$(request.resource.data.space)).data.action == request.method)
