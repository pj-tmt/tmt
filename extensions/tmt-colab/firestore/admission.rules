// Colab admission for the Firestore backend. Remote composes this fragment under x/colab.
// It admits ciphertext and checks routing facts; it is never authority. Rules cannot hash or
// verify Ed25519, so every client still verifies statements, chains and envelopes.
//
// Tenancy: every document ID is built from the fields it carries (space, page, ...), and every
// condition looks up the admission documents of that same space and page. The text is identical
// for every tenant, so one deploy serves all homes; owner A cannot reach owner B's space.
// IDs join fixed-grammar fields with "_" (no field contains "_", except a trailing uid).
//
// spaces/{space}: first writer owns it (an availability squat, never confidentiality or
//   authority: clients verify the owner chain against the space ID). Never updated or deleted.
// pages/{space_page}: owner admission, finite expiry at most 365 days from refresh.
//   Client policy defaults to 30 days; owner overrides are 1 through 365 days.
//   Deleting it denies every read and write of the page at once.
// links/{space_page_link}: owner-written enrollment secret for a share link, unreadable by holders.
// members/{space_page_uid}: who may read or write. The owner writes rows; a link holder creates
//   its own row by equality with the link's secret (Rules cannot hash a join proof).
// log/{space_page_epoch_stream_seq}: immutable encrypted envelope, contiguous per stream. A stream
//   belongs to the uid that wrote its first entry: seq 1 is safe because a stream ID is unknown until
//   used, and every later entry needs its predecessor's uid to equal the writer's.
// checkpoints/{space_page_epoch_object_index}: immutable encrypted chunk, owned by the
//   uid that wrote index 0 the same way, so no one can fill an object's later chunks with garbage.
//
// A list query is admitted by membership and the page's expiry only: Firestore cannot compare
// a document's own expiresAt with request.time in a query, so a query may return an entry past
// its own expiresAt while the page is still live. A single-document get also checks the
// entry's expiresAt. Clients drop expired entries; physical removal is TTL and cleanup.
// Owners may update only expiry, within the page bound, and delete expired entries or entries
// of an expired/deleted page. Ciphertext and routing facts remain immutable.

match /spaces/{space} {
  allow get: if request.auth != null && resource.data.owner == request.auth.uid;
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['space', 'owner'])
    && request.resource.data.keys().hasAll(['space', 'owner'])
    && space.matches('[a-z2-7]{32}')
    && request.resource.data.space == space
    && request.resource.data.owner == request.auth.uid;
}

match /pages/{id} {
  allow get: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
  allow create, update: if request.auth != null
    && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'state', 'expiresAt'])
    && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'state', 'expiresAt'])
    && request.resource.data.space.matches('[a-z2-7]{32}')
    && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && id == request.resource.data.space + '_' + request.resource.data.page
    && request.resource.data.epoch is int
    && request.resource.data.epoch >= 1
    && request.resource.data.state in ['open', 'archived']
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt <= request.time + duration.value(365, 'd')
    && ext.get(/spaces/$(request.resource.data.space)).data.owner == request.auth.uid
    && (request.method == 'create' || request.resource.data.epoch >= resource.data.epoch);
  allow delete: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
}

match /links/{id} {
  allow get, list: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['space', 'page', 'link', 'role', 'token'])
    && request.resource.data.keys().hasAll(['space', 'page', 'link', 'role', 'token'])
    && request.resource.data.link.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && id == request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link
    && request.resource.data.role in ['viewer', 'commenter', 'editor']
    && request.resource.data.token.matches('[A-Za-z0-9_-]{43}')
    && ext.exists(/pages/$(request.resource.data.space + '_' + request.resource.data.page))
    && ext.get(/spaces/$(request.resource.data.space)).data.owner == request.auth.uid;
  allow delete: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
}

match /members/{id} {
  allow get: if request.auth != null
    && (resource.data.uid == request.auth.uid
      || ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid);
  allow list: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
  allow create, update: if request.auth != null
    && request.resource.data.space.matches('[a-z2-7]{32}')
    && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && request.resource.data.uid is string
    && id == request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.uid
    && request.resource.data.role in ['viewer', 'commenter', 'editor', 'bridge']
    && ext.exists(/pages/$(request.resource.data.space + '_' + request.resource.data.page))
    && ((request.resource.data.keys().hasOnly(['space', 'page', 'uid', 'role'])
        && request.resource.data.keys().hasAll(['space', 'page', 'uid', 'role'])
        && ext.get(/spaces/$(request.resource.data.space)).data.owner == request.auth.uid)
      || (request.method == 'create'
        && request.resource.data.keys().hasOnly(['space', 'page', 'uid', 'role', 'link', 'token'])
        && request.resource.data.keys().hasAll(['space', 'page', 'uid', 'role', 'link', 'token'])
        && request.resource.data.uid == request.auth.uid
        && ext.get(/links/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link)).data.token == request.resource.data.token
        && ext.get(/links/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link)).data.role == request.resource.data.role));
  allow delete: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid;
}

match /log/{id} {
  allow get: if request.auth != null
    && ext.exists(/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid))
    && resource.data.expiresAt > request.time
    && ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
  allow list: if request.auth != null
    && ext.exists(/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid))
    && ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'stream', 'seq', 'uid', 'hash', 'envelope', 'expiresAt'])
    && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'stream', 'seq', 'uid', 'hash', 'envelope', 'expiresAt'])
    && request.resource.data.space.matches('[a-z2-7]{32}')
    && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && request.resource.data.stream.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && request.resource.data.epoch is int
    && request.resource.data.seq is int
    && request.resource.data.seq >= 1
    && request.resource.data.seq <= 9007199254740991
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.hash.matches('[A-Za-z0-9_-]{43}')
    && request.resource.data.envelope is string
    && request.resource.data.envelope.size() <= 354304
    && id == request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.stream + '_' + string(request.resource.data.seq)
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.state == 'open'
    && ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.epoch == request.resource.data.epoch
    && request.resource.data.expiresAt <= ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.expiresAt
    && ext.get(/members/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.auth.uid)).data.role != 'viewer'
    && (request.resource.data.seq == 1
      || ext.getAfter(/log/$(request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.stream + '_' + string(request.resource.data.seq - 1))).data.uid == request.auth.uid);
  allow update: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt <= ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt;
  allow delete: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid
    && (resource.data.expiresAt <= request.time
      || !ext.exists(/pages/$(resource.data.space + '_' + resource.data.page))
      || ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt <= request.time);
}

match /checkpoints/{id} {
  allow get: if request.auth != null
    && ext.exists(/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid))
    && resource.data.expiresAt > request.time
    && ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
  allow list: if request.auth != null
    && ext.exists(/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid))
    && ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
  allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'object', 'index', 'count', 'uid', 'bytes', 'expiresAt'])
    && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'object', 'index', 'count', 'uid', 'bytes', 'expiresAt'])
    && request.resource.data.space.matches('[a-z2-7]{32}')
    && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
    && request.resource.data.epoch is int
    && request.resource.data.object.matches('[0-9a-f]{64}')
    && request.resource.data.index is int
    && request.resource.data.count is int
    && request.resource.data.index >= 0
    && request.resource.data.index < request.resource.data.count
    && request.resource.data.count <= 513
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.bytes is string
    && request.resource.data.bytes.size() <= 43692
    && id == request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.object + '_' + string(request.resource.data.index)
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.state == 'open'
    && ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.epoch == request.resource.data.epoch
    && request.resource.data.expiresAt <= ext.get(/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.expiresAt
    && ext.get(/members/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.auth.uid)).data.role != 'viewer'
    && (request.resource.data.index == 0
      || ext.getAfter(/checkpoints/$(request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.object + '_0')).data.uid == request.auth.uid);
  allow update: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt <= ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt;
  allow delete: if request.auth != null
    && ext.get(/spaces/$(resource.data.space)).data.owner == request.auth.uid
    && (resource.data.expiresAt <= request.time
      || !ext.exists(/pages/$(resource.data.space + '_' + resource.data.page))
      || ext.get(/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt <= request.time);
}
