    && (ext.getAfter(/uid-budgets/$(resource.data.space + '_' + resource.data.quotaUid)).data.chargedBytes == ext.get(/uid-budgets/$(resource.data.space + '_' + resource.data.quotaUid)).data.chargedBytes - resource.data.quotaBytes && ext.getAfter(/uid-budgets/$(resource.data.space + '_' + resource.data.quotaUid)).data.entries == ext.get(/uid-budgets/$(resource.data.space + '_' + resource.data.quotaUid)).data.entries - 1));
