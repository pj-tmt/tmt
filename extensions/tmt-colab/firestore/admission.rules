    && (ext.getAfter(/space-budgets/$(resource.data.space)).data.actor == request.auth.uid && ext.getAfter(/space-budgets/$(resource.data.space)).data.targetKind == 'pages' && ext.getAfter(/space-budgets/$(resource.data.space)).data.targetId == id && ext.getAfter(/space-budgets/$(resource.data.space)).data.action == request.method)
