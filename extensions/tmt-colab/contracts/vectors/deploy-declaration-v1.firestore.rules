      function response() { return machineOwner(machine) && request.resource.data.kind in ['receipt','route-response','refused'] && request.resource.data.keys().hasOnly(['uid','kind','body','createdAt']) && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-response'); }
      allow create: if request.auth != null && request.resource.data.keys().hasAll(['uid','kind','body','createdAt']) &&
        request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128 && request.resource.data.kind is string &&
        request.resource.data.body is bytes && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 16384 && request.resource.data.createdAt == request.time && (candidate() || response());
      allow get: if request.auth != null && (machineOwner(machine) || resource == null || resource.data.uid == request.auth.uid);
      allow list: if machineOwner(machine) && request.query.limit == 1;
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/inbox/{id} {
      allow create: if carrier() && peerCreate(machine) &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerRead(machine);
      allow list: if machineOwner(machine) && request.query.limit == 1;
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/responses/{id} {
      allow create: if machineOwner(machine) && carrier() &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerRead(machine);
      allow delete: if machineOwner(machine);
    }
    match /x/colab {
      match /spaces/{space} {
        allow get: if request.auth != null && resource.data.owner == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'owner']) && request.resource.data.keys().hasAll(['space', 'owner']) && space.matches('[a-z2-7]{32}') && request.resource.data.space == space && request.resource.data.owner == request.auth.uid;
      }
      match /pages/{id} {
        allow get: if request.auth != null && (get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid || exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)));
        allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'state', 'expiresAt']) && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'state', 'expiresAt']) && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && id == request.resource.data.space + '_' + request.resource.data.page && request.resource.data.epoch is int && request.resource.data.epoch >= 1 && request.resource.data.state in ['open', 'archived'] && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(365, 'd') && get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid && (request.method == 'create' || request.resource.data.epoch >= resource.data.epoch);
        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /links/{id} {
        allow get, list: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'link', 'role', 'token']) && request.resource.data.keys().hasAll(['space', 'page', 'link', 'role', 'token']) && request.resource.data.link.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && id == request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link && request.resource.data.role in ['viewer', 'commenter', 'editor'] && request.resource.data.token.matches('[A-Za-z0-9_-]{43}') && exists(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)) && get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid;
        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /members/{id} {
        allow get: if request.auth != null && (resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid);
        allow list: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
