rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /x/colab {
      match /spaces/{space} {
        allow get: if request.auth != null && resource.data.owner == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'owner']) && request.resource.data.keys().hasAll(['space', 'owner']) && space.matches('[a-z2-7]{32}') && request.resource.data.space == space && request.resource.data.owner == request.auth.uid;
      }
      match /pages/{id} {
        allow get: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
        allow create, update: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'state', 'expiresAt']) && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'state', 'expiresAt']) && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && id == request.resource.data.space + '_' + request.resource.data.page && request.resource.data.epoch is int && request.resource.data.epoch >= 1 && request.resource.data.state in ['open', 'archived'] && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid && (request.method == 'create' || request.resource.data.epoch >= resource.data.epoch);
        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /links/{id} {
        allow get, list: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'link', 'role', 'token']) && request.resource.data.keys().hasAll(['space', 'page', 'link', 'role', 'token']) && request.resource.data.link.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && id == request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link && request.resource.data.role in ['viewer', 'commenter', 'editor'] && request.resource.data.token.matches('[A-Za-z0-9_-]{43}') && exists(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)) && get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid;
        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /members/{id} {
        allow get: if request.auth != null && (resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid);
        allow list: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
        allow create, update: if request.auth != null && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.uid is string && id == request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.uid && request.resource.data.role in ['viewer', 'commenter', 'editor', 'bridge'] && exists(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)) && ((request.resource.data.keys().hasOnly(['space', 'page', 'uid', 'role']) && request.resource.data.keys().hasAll(['space', 'page', 'uid', 'role']) && get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid) || (request.method == 'create' && request.resource.data.keys().hasOnly(['space', 'page', 'uid', 'role', 'link', 'token']) && request.resource.data.keys().hasAll(['space', 'page', 'uid', 'role', 'link', 'token']) && request.resource.data.uid == request.auth.uid && get(/databases/$(database)/documents/x/colab/links/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link)).data.token == request.resource.data.token && get(/databases/$(database)/documents/x/colab/links/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.resource.data.link)).data.role == request.resource.data.role));
        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /log/{id} {
        allow get: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow list: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'stream', 'seq', 'hash', 'envelope', 'expiresAt']) && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'stream', 'seq', 'hash', 'envelope', 'expiresAt']) && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.stream.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.epoch is int && request.resource.data.seq is int && request.resource.data.seq >= 1 && request.resource.data.seq <= 9007199254740991 && request.resource.data.hash.matches('[A-Za-z0-9_-]{43}') && request.resource.data.envelope is string && request.resource.data.envelope.size() <= 354304 && id == request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.stream + '_' + string(request.resource.data.seq) && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.state == 'open' && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.epoch == request.resource.data.epoch && request.resource.data.expiresAt <= get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.expiresAt && get(/databases/$(database)/documents/x/colab/members/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.auth.uid)).data.role != 'viewer' && (request.resource.data.seq == 1 || existsAfter(/databases/$(database)/documents/x/colab/log/$(request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.stream + '_' + string(request.resource.data.seq - 1))));
      }
      match /checkpoints/{id} {
        allow get: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow list: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'object', 'index', 'count', 'bytes', 'expiresAt']) && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'object', 'index', 'count', 'bytes', 'expiresAt']) && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.epoch is int && request.resource.data.object.matches('[0-9a-f]{64}') && request.resource.data.index is int && request.resource.data.count is int && request.resource.data.index >= 0 && request.resource.data.index < request.resource.data.count && request.resource.data.count <= 513 && request.resource.data.bytes is string && request.resource.data.bytes.size() <= 43692 && id == request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.object + '_' + string(request.resource.data.index) && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.state == 'open' && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.epoch == request.resource.data.epoch && request.resource.data.expiresAt <= get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.expiresAt && get(/databases/$(database)/documents/x/colab/members/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.auth.uid)).data.role != 'viewer';
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
