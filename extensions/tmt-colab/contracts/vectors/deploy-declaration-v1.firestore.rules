        allow delete: if request.auth != null && get(/databases/$(database)/documents/x/colab/spaces/$(resource.data.space)).data.owner == request.auth.uid;
      }
      match /log/{id} {
        allow get: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow list: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(resource.data.space + '_' + resource.data.page + '_' + request.auth.uid)) && get(/databases/$(database)/documents/x/colab/pages/$(resource.data.space + '_' + resource.data.page)).data.expiresAt > request.time;
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['space', 'page', 'epoch', 'stream', 'seq', 'uid', 'hash', 'envelope', 'expiresAt']) && request.resource.data.keys().hasAll(['space', 'page', 'epoch', 'stream', 'seq', 'uid', 'hash', 'envelope', 'expiresAt']) && request.resource.data.space.matches('[a-z2-7]{32}') && request.resource.data.page.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.stream.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.epoch is int && request.resource.data.seq is int && request.resource.data.seq >= 1 && request.resource.data.seq <= 9007199254740991 && request.resource.data.uid == request.auth.uid && request.resource.data.hash.matches('[A-Za-z0-9_-]{43}') && request.resource.data.envelope is string && request.resource.data.envelope.matches('[\\x00-\\x7F]*') && request.resource.data.envelope.size() <= 354304 && id == request.resource.data.space + '_' + request.resource.data.page + '_' + string(request.resource.data.epoch) + '_' + request.resource.data.stream + '_' + string(request.resource.data.seq) && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.state == 'open' && get(/databases/$(database)/documents/x/colab/pages/$(request.resource.data.space + '_' + request.resource.data.page)).data.epoch == request.resource.data.epoch && request.resource.data.expiresAt <= request.time + duration.value(365, 'd') && get(/databases/$(database)/documents/x/colab/members/$(request.resource.data.space + '_' + request.resource.data.page + '_' + request.auth.uid)).data.role != 'viewer' && (request.resource.data.seq == 1 || get(/databases/$(database)/documents/x/colab/spaces/$(request.resource.data.space)).data.owner == request.auth.uid || getAfter