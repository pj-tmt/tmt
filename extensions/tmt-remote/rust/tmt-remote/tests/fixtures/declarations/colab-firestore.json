{
  "version": 1,
  "extension": "colab",
  "backend": "firestore",
  "resources": [
    {
      "name": "page-log",
      "kind": "log",
      "path": "pages/log",
      "limits": { "maxObjectBytes": 262144, "maxNamespaceBytes": 16777216, "maxEntries": 1024 },
      "ttlField": "expiresAt",
      "indexes": [
        { "field": "sequence", "direction": "asc" },
        { "field": "expiresAt", "direction": "asc" }
      ]
    },
    {
      "name": "page-checkpoint",
      "kind": "checkpoint",
      "path": "pages/checkpoints",
      "limits": { "maxObjectBytes": 4194304, "maxNamespaceBytes": 33554432, "maxEntries": 64 },
      "ttlField": "expiresAt",
      "indexes": [{ "field": "epoch", "direction": "desc" }]
    },
    {
      "name": "page-blob",
      "kind": "blob",
      "path": "pages/blobs",
      "limits": { "maxObjectBytes": 12582912, "maxNamespaceBytes": 67108864, "maxEntries": 256 },
      "ttlField": null,
      "indexes": []
    },
    {
      "name": "presence",
      "kind": "awareness",
      "path": "pages/presence",
      "limits": { "maxObjectBytes": 4096, "maxNamespaceBytes": 65536, "maxEntries": 64 },
      "ttlField": null,
      "indexes": []
    }
  ],
  "admission": {
    "artifact": "rules/colab-admission.rules",
    "digest": "f055b672317c370949655803a7c3e1f9463db29f561ca11a3b2baeebc32c9edd",
    "entryPoint": "colabAdmitted"
  }
}
