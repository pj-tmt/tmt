// Test fixture standing in for a Rules fragment; Remote composes it and never evaluates it.
match /docs/{docId} {
  allow get, list: if request.auth != null
    && ext.exists(/members/$(request.auth.uid))
    && resource.data.expiresAt > request.time;
  allow create: if request.auth != null
    && ext.exists(/members/$(request.auth.uid))
    && request.resource.data.keys().hasOnly(['body', 'expiresAt'])
    && request.resource.data.expiresAt is timestamp;
}
match /members/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid; /* own row */
}
match /heads/{pageId} {
  allow create: if request.auth != null
    && ext.getAfter(/heads/$(pageId)).data.seq == request.resource.data.seq
    && request.time < request.time + duration.value(30, 'd');
}
match /open/{rest=**} {
  allow read: if request.auth.uid in ['u1', 'u2'] || resource.data.public == true;
}
