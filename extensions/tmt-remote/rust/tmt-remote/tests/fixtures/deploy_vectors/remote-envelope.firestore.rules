rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function machineOwner(machine) {
      return request.auth != null &&
        get(/databases/$(database)/documents/m/$(machine)).data.uid == request.auth.uid;
    }
    function routedPeer(machine) {
      return get(/databases/$(database)/documents/m/$(machine)/peers/$(request.auth.uid)).data;
    }
    function carrier() {
      return request.resource.data.keys().hasOnly(['peer', 'carrier', 'createdAt']) &&
        request.resource.data.keys().hasAll(['peer', 'carrier', 'createdAt']) &&
        request.resource.data.peer is string &&
        request.resource.data.peer.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        request.resource.data.carrier is bytes &&
        request.resource.data.carrier.size() > 0 &&
        request.resource.data.carrier.size() <= 778680 &&
        request.resource.data.createdAt == request.time;
    }
    function peerCreate(machine) {
      let row = routedPeer(machine);
      return request.auth != null && row.revoked == false && row.expiresAt > request.time &&
        request.resource.data.peer == row.peer;
    }
    function peerRead(machine) {
      let row = routedPeer(machine);
      return request.auth != null && row.revoked == false && row.expiresAt > request.time &&
        (resource == null || resource.data.peer == row.peer);
    }
    function machineFields() {
      return request.resource.data.keys().hasOnly(['uid','authenticationKey','descriptor']) &&
        request.resource.data.keys().hasAll(['uid','authenticationKey','descriptor']) &&
        request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128 &&
        request.resource.data.authenticationKey is bytes && request.resource.data.authenticationKey.size() == 32 &&
        request.resource.data.descriptor is bytes && request.resource.data.descriptor.size() > 0 && request.resource.data.descriptor.size() <= 4096;
    }
    match /m/{machine} {
      allow create: if request.auth != null && machine.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && machineFields() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && machineFields() && request.resource.data.uid == resource.data.uid && request.resource.data.authenticationKey == resource.data.authenticationKey;
      allow get: if request.auth != null;
    }
    match /m/{machine}/peers/{uid} {
      allow create, update: if machineOwner(machine) && request.resource.data.keys().hasOnly(['peer','revoked','expiresAt']) && request.resource.data.keys().hasAll(['peer','revoked','expiresAt']) &&
        request.resource.data.peer is string && request.resource.data.peer.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') && request.resource.data.revoked is bool && request.resource.data.expiresAt is timestamp;
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/enroll/{id} {
      function candidate() { return request.resource.data.kind in ['join','reroute'] && request.resource.data.uid == request.auth.uid && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'); }
      function response() { return machineOwner(machine) && request.resource.data.kind in ['receipt','route-response','refused'] && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-response'); }
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid','kind','body','createdAt']) && request.resource.data.keys().hasAll(['uid','kind','body','createdAt']) &&
        request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128 && request.resource.data.kind is string &&
        request.resource.data.body is bytes && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 16384 && request.resource.data.createdAt == request.time && (candidate() || response());
      allow get: if request.auth != null && (machineOwner(machine) || resource == null || resource.data.uid == request.auth.uid);
      allow list: if machineOwner(machine) && request.query.limit == 1;
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/inbox/{id} {
      allow create: if carrier() && peerCreate(machine) &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerRead(machine);
      allow list: if machineOwner(machine) && request.query.limit == 1;
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/responses/{id} {
      allow create: if machineOwner(machine) && carrier() &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerRead(machine);
      allow delete: if machineOwner(machine);
    }
    match /x/colab {
      match /docs/{docId} {
        allow get, list: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(request.auth.uid)) && resource.data.expiresAt > request.time;
        allow create: if request.auth != null && exists(/databases/$(database)/documents/x/colab/members/$(request.auth.uid)) && request.resource.data.keys().hasOnly(['body', 'expiresAt']) && request.resource.data.expiresAt is timestamp;
      }
      match /members/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /heads/{pageId} {
        allow create: if request.auth != null && getAfter(/databases/$(database)/documents/x/colab/heads/$(pageId)).data.seq == request.resource.data.seq && request.time < request.time + duration.value(30, 'd');
      }
      match /open/{rest=**} {
        allow read: if request.auth.uid in ['u1', 'u2'] || resource.data.public == true;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
