{
  "headers": [
    {
      "glob": "/index.html",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "glob": "/join.html",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'sha256-NpeORGz2qxhbVfcDZIXac+qBwYLtGhoc+ifnMvpWt9U='; style-src 'self'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
      }
    },
    {
      "glob": "/sdk/invite-v1.js",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/javascript; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "glob": "/sdk/invite.css",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/css; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "glob": "/tmt/declarations/colab.json",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Type": "application/json; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "regex": "^/$",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "regex": "^/colab/?$",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "regex": "^/(p|read)/[A-Za-z0-9_-]{4,64}$",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "regex": "^/pair$",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "regex": "^/join$",
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/html; charset=utf-8",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'sha256-NpeORGz2qxhbVfcDZIXac+qBwYLtGhoc+ifnMvpWt9U='; style-src 'self'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
      }
    }
  ],
  "rewrites": [
    {
      "regex": "^/colab/?$",
      "path": "/index.html"
    },
    {
      "regex": "^/(p|read)/[A-Za-z0-9_-]{4,64}$",
      "path": "/index.html"
    },
    {
      "regex": "^/pair$",
      "path": "/index.html"
    },
    {
      "regex": "^/join$",
      "path": "/join.html"
    }
  ]
}
