// tmt-remote deployment 3f2b8c1e-5d4a-4e7b-9c1d-2a6f8e0b4c11 rules d84fe141967e7e8601d4990de08339d5d37c949270ad8621ba2107e8fe019014
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /x/colab {
      match /log/{entry} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.keys().hasAll(['sequence', 'expiresAt']);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
