rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function machineOwner(machine) {
      return request.auth != null &&
        get(/databases/$(database)/documents/m/$(machine)).data.uid == request.auth.uid;
    }
    function peerUser(machine, peer) {
      let row = get(/databases/$(database)/documents/m/$(machine)/peers/$(peer)).data;
      return request.auth != null && row.uid == request.auth.uid &&
        row.revoked == false && row.expiresAt > request.time;
    }
    function carrier(peer) {
      return request.resource.data.keys().hasOnly(['peerId', 'carrier', 'createdAt']) &&
        request.resource.data.keys().hasAll(['peerId', 'carrier', 'createdAt']) &&
        request.resource.data.peerId == peer &&
        request.resource.data.carrier is bytes &&
        request.resource.data.carrier.size() > 0 &&
        request.resource.data.carrier.size() <= CLOUD_CARRIER_BYTES &&
        request.resource.data.createdAt == request.time;
    }
    match /m/{machine}/peers/{peer}/inbox/{id} {
      allow create: if peerUser(machine, peer) && carrier(peer) &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerUser(machine, peer);
      allow delete: if machineOwner(machine);
    }
    match /m/{machine}/peers/{peer}/responses/{id} {
      allow create: if machineOwner(machine) && carrier(peer) &&
        id.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow get: if machineOwner(machine) || peerUser(machine, peer);
      allow delete: if machineOwner(machine);
    }
    // Rules v2 collection-group authorization remains scoped to the selected machine.
    match /m/{machine}/{tail=**}/inbox/{id} {
      allow list: if machineOwner(machine) && request.query.limit == 1;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
