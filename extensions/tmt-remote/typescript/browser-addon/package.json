{
  "name": "@tmt/browser-addon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vp build",
    "check": "tsc --noEmit && vp lint --config vite.config.ts --deny-warnings src e2e *.ts && vp fmt --config vite.config.ts --check .",
    "test": "vp test run --config vite.config.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^25.0.3",
    "typescript": "^5.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}
