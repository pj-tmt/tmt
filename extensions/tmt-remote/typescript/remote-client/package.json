{
  "name": "@tmt/remote-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && oxlint --deny-warnings src test e2e vitest.config.ts vite.config.ts playwright.config.ts && prettier --check .",
    "test": "python3 test/reference.py --check && vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.3",
    "oxlint": "^1.34.0",
    "prettier": "^3.7.4",
    "typescript": "^5.3.0",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  }
}
