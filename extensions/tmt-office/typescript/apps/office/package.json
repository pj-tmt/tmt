{
  "name": "@tmt/office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview --host 127.0.0.1",
    "test": "vp test run --config vite.config.ts",
    "test:browser": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:browser:capacity": "playwright test --config playwright.capacity.config.ts",
    "test:browser:partitions": "node scripts/verify-browser-partitions.mjs",
    "test:browser:native": "playwright test --config playwright.native.config.ts",
    "type:check": "tsc --noEmit",
    "type:check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin src e2e scripts vite.config.ts playwright.config.ts playwright.visual.config.ts playwright.all.config.ts playwright.capacity.config.ts playwright.emulator.config.ts playwright.local.config.ts playwright.native.config.ts",
    "format": "vp fmt --config vite.config.ts .",
    "format:check": "vp fmt --config vite.config.ts --check .",
    "check": "pnpm type:check && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.33",
    "firebase": "12.18.0",
    "jotai": "3.0.0",
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.34.0",
    "typescript": "^5.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}
