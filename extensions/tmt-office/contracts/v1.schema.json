{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tmt:office:wire:1.0",
  "title": "Office 1.0 work handoff messages (design contract, not a deployed API)",
  "description": "Authentication and current grants are verified outside the payload. Passing this schema does not authorize an action. See docs/office/design.md for policy and contracts/office/README.md for versioning.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/submitWork" },
    { "$ref": "#/$defs/reportDispatch" },
    { "$ref": "#/$defs/publishFinal" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "version": { "const": "1.0" },
    "requestText": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\uD800-\uDFFF]*$"
    },
    "finalText": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\uD800-\uDFFF]*$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository", "pullRequest", "headSha"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "pullRequest": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "supportedVersions", "requiredCapabilities"],
      "properties": {
        "kind": { "const": "hello" },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]{0,2}[.][0-9]{1,3}$" }
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        }
      }
    },
    "submitWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "worldId",
        "exchangeId",
        "agentId",
        "capability",
        "text",
        "expiresAtMs",
        "review"
      ],
      "properties": {
        "kind": { "const": "work.submit" },
        "version": { "$ref": "#/$defs/version" },
        "worldId": { "$ref": "#/$defs/id" },
        "exchangeId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" },
        "capability": { "const": "review" },
        "text": { "$ref": "#/$defs/requestText" },
        "expiresAtMs": { "$ref": "#/$defs/timestamp" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "reportDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "worldId", "exchangeId", "dispatchId", "evidence"],
      "properties": {
        "kind": { "const": "dispatch.report" },
        "version": { "$ref": "#/$defs/version" },
        "worldId": { "$ref": "#/$defs/id" },
        "exchangeId": { "$ref": "#/$defs/id" },
        "dispatchId": { "$ref": "#/$defs/id" },
        "evidence": { "enum": ["prepared", "sent", "uncertain", "definitely_failed"] }
      }
    },
    "publishFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "worldId", "exchangeId", "dispatchId", "result"],
      "properties": {
        "kind": { "const": "final.publish" },
        "version": { "$ref": "#/$defs/version" },
        "worldId": { "$ref": "#/$defs/id" },
        "exchangeId": { "$ref": "#/$defs/id" },
        "dispatchId": { "$ref": "#/$defs/id" },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "text"],
              "properties": {
                "state": { "const": "available" },
                "text": { "$ref": "#/$defs/finalText" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason"],
              "properties": {
                "state": { "const": "withheld" },
                "reason": { "enum": ["export_not_approved", "too_large"] }
              }
            }
          ]
        }
      }
    }
  }
}
