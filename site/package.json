{
  "name": "@tmt/site",
  "version": "0.0.0",
  "private": true,
  "description": "The tmt handbook website, built as static files for GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "tsc --noEmit && vp build && node scripts/spa-routes.mjs",
    "preview": "vp preview --host 127.0.0.1",
    "type:check": "tsc --noEmit",
    "lint": "vp lint --deny-warnings --react-plugin src scripts vite.config.ts \"$(git rev-parse --show-toplevel)/design/tokens\"",
    "format": "vp fmt . \"$(git rev-parse --show-toplevel)/design/tokens\"",
    "format:check": "vp fmt --check . \"$(git rev-parse --show-toplevel)/design/tokens\"",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "pnpm type:check && pnpm lint && pnpm format:check && node scripts/mdx-imports.mjs && node scripts/i18n-sync.mjs && pnpm test:scripts"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@tanstack/react-router": "1.170.33",
    "jotai": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vitest": "5.0.1"
    }
  }
}
