{
  "name": "@tmt/site",
  "version": "0.0.0",
  "private": true,
  "description": "The tmt handbook website, built as static files for GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/spa-routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "type:check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin src scripts vite.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm type:check && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@tanstack/react-router": "1.170.33",
    "jotai": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.67.0",
    "oxlint": "^1.34.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.3.0",
    "vite": "8.2.2"
  },
  "packageManager": "pnpm@10.33.0"
}
