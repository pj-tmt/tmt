{
  "name": "tmux-team",
  "version": "5.0.0-alpha.7",
  "description": "Private developer tooling for tmux-team",
  "private": true,
  "type": "module",
  "scripts": {
    "tmt": "sh ../scripts/tmt-dev.sh",
    "test": "pnpm test:run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:native": "vitest run --config test/native/vitest.config.ts",
    "test:stress:native": "vitest run --config test/stress/vitest.config.ts",
    "test:run": "vitest run",
    "lint": "oxlint test/ scripts/*.mjs",
    "docs:format:check": "prettier --config .prettierrc --check --ignore-path ../.gitignore ../AGENTS.md ../ARCHITECTURE.md ../CONVENTIONS.md ../DEVELOPMENT.md ../docs/native-release-verification.md ../docs/NATIVE-INSTALL.md ../docs/performance.md ../docs/extension-api.md ../REQUEST-RESPONSE.md \"../.agents/skills/**/SKILL.md\" ../.github/pull_request_template.md \"../docs/office/**/*.md\" services/office/README.md \"../contracts/office/*.md\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --config .prettierrc --write test/ scripts/*.mjs tsconfig.json tsconfig.e2e.json vitest.config.ts package.json ../.github/workflows/ci.yml services/office/firebase.json services/office/compose.yaml \"../contracts/office/*.json\"",
    "format:check": "prettier --config .prettierrc --check test/ scripts/*.mjs tsconfig.json tsconfig.e2e.json vitest.config.ts package.json ../.github/workflows/ci.yml services/office/firebase.json services/office/compose.yaml \"../contracts/office/*.json\"",
    "type:check": "tsc --noEmit",
    "check:tooling": "pnpm type:check && pnpm lint && pnpm format:check && pnpm docs:format:check",
    "check": "pnpm check:tooling && pnpm office:check && pnpm office:service:check && pnpm --filter @tmt/office type:check:e2e",
    "office:dev": "pnpm --filter @tmt/office --fail-if-no-match dev",
    "office:install": "cd apps/office && pnpm install --ignore-workspace --lockfile-dir \"$PWD/../..\" --frozen-lockfile",
    "office:build": "pnpm --filter @tmt/office --fail-if-no-match build",
    "office:build:local": "pnpm --filter @tmt/office --fail-if-no-match exec vite build --mode offline --outDir ../../../target/office-spa --emptyOutDir",
    "office:local:e2e": "pnpm --filter @tmt/office --fail-if-no-match test:browser:native",
    "office:test": "pnpm --filter @tmt/office --fail-if-no-match test",
    "office:check": "pnpm --filter @tmt/office --fail-if-no-match check",
    "office:service:check": "pnpm --filter @tmt/office-service --fail-if-no-match check",
    "office:service:test": "pnpm --filter @tmt/office-service --fail-if-no-match test",
    "office:service:build": "pnpm --filter @tmt/office-service --fail-if-no-match build"
  },
  "author": "Ben Hsieh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkh237/tmt.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.3",
    "ajv": "8.20.0",
    "better-sqlite3": "^13.0.3",
    "oxlint": "^1.34.0",
    "prettier": "^3.7.4",
    "tar": "7.5.22",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "nx": {
    "includedScripts": []
  }
}
