{
  "name": "tmux-team",
  "version": "5.0.0-alpha.8",
  "description": "Private developer tooling for tmux-team",
  "private": true,
  "type": "module",
  "scripts": {
    "tmt": "sh ../scripts/tmt-dev.sh",
    "test": "pnpm test:run",
    "test:watch": "vp test watch --config vitest.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:native": "vp test run --config test/native/vitest.config.ts",
    "test:stress:native": "vp test run --config test/stress/vitest.config.ts",
    "test:run": "vp test run --config vitest.config.ts",
    "lint": "oxlint test/ scripts/*.mjs",
    "docs:format:check": "node scripts/format-workspace.mjs --docs --check",
    "lint:fix": "pnpm lint --fix",
    "format": "node scripts/format-workspace.mjs",
    "format:check": "node scripts/format-workspace.mjs --check",
    "type:check": "tsc --noEmit",
    "check:tooling": "node scripts/release-please-run.mjs check-install && pnpm type:check && pnpm lint && pnpm format:check && pnpm docs:format:check",
    "check": "pnpm check:tooling && pnpm office:check && pnpm office:service:check && pnpm --filter @tmt/office type:check:e2e",
    "office:dev": "pnpm --filter @tmt/office --fail-if-no-match dev",
    "office:install": "cd ../extensions/tmt-office/typescript/apps/office && pnpm install --ignore-workspace --lockfile-dir \"$PWD/../../../../../typescript\" --frozen-lockfile",
    "office:build": "pnpm --filter @tmt/office --fail-if-no-match build",
    "office:build:local": "pnpm --filter @tmt/office --fail-if-no-match exec vp build --mode offline --outDir ../../../../../target/office-spa --emptyOutDir",
    "office:local:e2e": "pnpm --filter @tmt/office --fail-if-no-match test:browser:native",
    "office:test": "pnpm --filter @tmt/office --fail-if-no-match test",
    "office:check": "pnpm --filter @tmt/office --fail-if-no-match check",
    "office:service:check": "pnpm --filter @tmt/office-service --fail-if-no-match check",
    "office:service:test": "pnpm --filter @tmt/office-service --fail-if-no-match test",
    "office:service:build": "pnpm --filter @tmt/office-service --fail-if-no-match build"
  },
  "author": "Ben Hsieh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkh237/tmt.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.3",
    "ajv": "8.20.0",
    "better-sqlite3": "^13.0.3",
    "oxlint": "^1.34.0",
    "tar": "7.5.22",
    "typescript": "^5.3.0",
    "vite-plus": "1.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vitest": "5.0.1"
    }
  }
}
