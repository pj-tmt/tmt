  "unified": {
    "$comment": "The site's legacy --c-* roles resolve to the browser roles, so the site and every browser surface read one palette (#3937). A path ending in @dark is always the dark value: terminal mockups are dark in both themes.",
    "paper": "browser.surface.paper",
    "sheet": "browser.surface.code",
    "text": "browser.color.selected-text",
    "muted": "browser.color.secondary",
    "dim": "browser.color.secondary",
    "rule": "browser.surface.rule",
    "accent": "browser.color.selected-text",
    "accent-soft": "browser.surface.selection",
    "selection": "browser.surface.selection",
    "term": "browser.surface.sheet@dark",
    "term-bar": "browser.surface.code@dark",
    "term-edge": "browser.surface.rule@dark"
  },
