    "motion": {
      "$description": "Motion: two durations, two easings and the pop and slide distances. Under prefers-reduced-motion every duration is 0ms, so a change is instant.",
      "fast": "120ms",
      "base": "180ms",
      "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
      "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "scale": "0.96",
      "rise": "6px"
    }
