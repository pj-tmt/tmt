{
  "$comment": "The tmt design tokens. Terminal renderings are the ANSI names the CLI uses (tmt-cli-style palette); web renderings are the light and dark values. Terminal mockups on the site always use the dark values, as the default tmt theme does.",
  "color": {
    "text": {
      "use": "Normal text",
      "dark": "#D8D8D8",
      "light": "#171717",
      "terminal": "default"
    },
    "muted": {
      "use": "Labels and headers",
      "dark": "#B0B0B0",
      "light": "#626262",
      "terminal": "white"
    },
    "dim": {
      "use": "Secondary text, borders, empty values",
      "dark": "#858585",
      "light": "#767676",
      "terminal": "dim"
    },
    "accent": {
      "use": "Focus, the selected tab, keys and links in prose",
      "dark": "#7AA2F7",
      "light": "#1F5FBF",
      "terminal": "blue"
    },
    "waiting": {
      "use": "\u25c6 waiting on you, anything that needs attention",
      "dark": "#FF9E64",
      "light": "#965027",
      "terminal": "yellow"
    },
    "working": {
      "use": "A member at work, success \u2713",
      "dark": "#9ECE6A",
      "light": "#4F6A33",
      "terminal": "green"
    },
    "review": {
      "use": "In review, waiting on someone else; the Claude Code driver",
      "dark": "#BB9AF7",
      "light": "#7847BD",
      "terminal": "magenta"
    },
    "blocked": {
      "use": "Blocked, failed, errors",
      "dark": "#F7768E",
      "light": "#B62C3B",
      "terminal": "red"
    },
    "link": {
      "use": "Links you can open; the Codex driver",
      "dark": "#7DCFFF",
      "light": "#006B8F",
      "terminal": "cyan"
    },
    "selection": {
      "use": "The selected row (background)",
      "dark": "#4A4A4A",
      "light": "#C8C8C8",
      "terminal": "reverse"
    },
    "conversation": {
      "use": "The row of the agent whose conversation has focus (background)",
      "dark": "#2B3550",
      "light": "#DCE4F7",
      "terminal": "reverse"
    },
    "track": {
      "use": "The empty part of a meter (background)",
      "dark": "#383838",
      "light": "#E0E0E0",
      "terminal": "dim"
    },
    "unread": {
      "use": "Submitted reply not yet opened by the current actor (glyph only)",
      "dark": "#7AA2F7",
      "light": "#1F5FBF",
      "terminal": "blue"
    },
    "keycap": {
      "use": "Keyboard shortcut background",
      "dark": "#555555",
      "light": "#555555",
      "terminal": "black"
    },
    "keycap-selected": {
      "use": "Keyboard shortcut inside the selected control (background)",
      "dark": "#707070",
      "light": "#707070",
      "terminal": "bright black"
    },
    "code": {
      "use": "Inline code and code blocks in rendered Markdown (foreground only)",
      "dark": "#A9B1D6",
      "light": "#3B4261",
      "terminal": "white"
    },
    "attachment": {
      "use": "Attachment chip and preview background",
      "dark": "#2C3650",
      "light": "#DCE7FC",
      "terminal": "blue"
    },
    "attachment-ink": {
      "use": "Attachment label and preview frame",
      "dark": "#C0D4FF",
      "light": "#1D3E73",
      "terminal": "bright white"
    }
  },
  "surface": {
    "paper": {
      "use": "Page background",
      "dark": "#1A1B26",
      "light": "#F4F6FB"
    },
    "sheet": {
      "use": "Raised panels and cards",
      "dark": "#16161E",
      "light": "#FFFFFF"
    },
    "rule": {
      "use": "Hairlines and borders",
      "dark": "#292E42",
      "light": "#DDE2EE"
    },
    "accent-soft": {
      "use": "Inline code, shipped tags",
      "dark": "#1F2A48",
      "light": "#E6EBFA"
    },
    "waiting-soft": {
      "use": "Callouts, planned tags",
      "dark": "#3A2A1F",
      "light": "#FFEFE2"
    },
    "term": {
      "use": "Terminal mockups",
      "dark": "#13141C",
      "light": "#1A1B26"
    },
    "term-bar": {
      "use": "Terminal status and key bars",
      "dark": "#101118",
      "light": "#16161E"
    },
    "term-edge": {
      "use": "Pane borders inside mockups",
      "dark": "#292E42",
      "light": "#292E42"
    }
  },
  "font": {
    "display": {
      "use": "Headings",
      "stack": "Inter, -apple-system, system-ui, \"Segoe UI\", sans-serif"
    },
    "body": {
      "use": "Prose",
      "stack": "Inter, -apple-system, system-ui, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "use": "Commands, labels, terminal mockups",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "header": {
    "height": "62px",
    "compact-height": "56px",
    "compact-max-width": "760px",
    "padding-inline": "36px",
    "gap": "12px",
    "mark-size": "12px",
    "mark-line-height": "1",
    "mark-weight": "600",
    "wordmark-size": "14px",
    "wordmark-line-height": "1.2",
    "wordmark-weight": "600",
    "title-size": "16px",
    "title-line-height": "1.2",
    "title-weight": "600",
    "action-size": "13px",
    "action-line-height": "1.2",
    "action-weight": "400",
    "icon-size": "18px",
    "icon-stroke": "1.75",
    "compact-padding-inline": "18px"
  },
  "breakpoint": {
    "sm": {
      "use": "Narrow terminal: the smallest width a view must fit",
      "cells": 80
    },
    "md": {
      "use": "Medium terminal: a second optional step appears",
      "cells": 100
    },
    "lg": {
      "use": "Wide terminal: every optional part is shown",
      "cells": 140
    }
  },
  "mark": {
    "\u25cf": "running or active",
    "\u25cb": "offline or ended",
    "\u25cc": "bound to a pane, no agent running",
    "\u25c6": "waits on your decision",
    "!": "warning",
    "\u2717": "failed or blocked",
    "\u2713": "done",
    "\u25d0": "in review, waiting on someone else (board only)",
    "\u21bb": "leads a resume action, never a row's state",
    "\u270e": "an annotation you sent (board only)",
    "\u2039 \u203a": "tabs off the end of a line (board only)",
    "\u25b8": "a folded Squad board pane (board only)",
    "\u25be": "an open foldable pane in a toggle hint (board only)",
    "\u2260": "differs from all boards (this squad overrides it; board only)",
    "~": "approximate observed token total from incomplete coverage (board only)",
    "\u2248": "estimate marker before a list-price quote (board only)",
    "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588": "completed-request trend: \u2581 measured zero, \u2582\u2013\u2588 relative totals, blank no data (board only)",
    "\u29c9": "pasted-text attachment (board only; ASCII: [Pasted])",
    "\u00d7": "remove a pasted-text attachment (board only; ASCII: x)",
    "\u2261": "a conversation's Notes list and its summary chip (board only; the word Notes names it, so no ASCII form)"
  },
