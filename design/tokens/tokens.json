{
  "$comment": "The tmt design tokens. Terminal renderings are the ANSI names the CLI uses (tmt-cli-style palette); web renderings are the light and dark values. Terminal mockups on the site always use the dark values, as the default tmt theme does.",
  "color": {
    "text": {
      "use": "Normal text",
      "dark": "#C0CAF5",
      "light": "#343B58",
      "terminal": "default"
    },
    "muted": {
      "use": "Labels and headers",
      "dark": "#9AA5CE",
      "light": "#5A6390",
      "terminal": "white"
    },
    "dim": {
      "use": "Secondary text, borders, empty values",
      "dark": "#7A83AE",
      "light": "#68709A",
      "terminal": "dim"
    },
    "accent": {
      "use": "Focus, the selected tab, keys and links in prose",
      "dark": "#7AA2F7",
      "light": "#1F5FBF",
      "terminal": "blue"
    },
    "waiting": {
      "use": "◆ waiting on you, anything that needs attention",
      "dark": "#FF9E64",
      "light": "#965027",
      "terminal": "yellow"
    },
    "working": {
      "use": "A member at work, success ✓",
      "dark": "#9ECE6A",
      "light": "#4F6A33",
      "terminal": "green"
    },
    "review": {
      "use": "In review, waiting on someone else; the Claude Code driver",
      "dark": "#BB9AF7",
      "light": "#7847BD",
      "terminal": "magenta"
    },
    "blocked": {
      "use": "Blocked, failed, errors",
      "dark": "#F7768E",
      "light": "#B62C3B",
      "terminal": "red"
    },
    "link": {
      "use": "Links you can open; the Codex driver",
      "dark": "#7DCFFF",
      "light": "#006B8F",
      "terminal": "cyan"
    },
    "selection": {
      "use": "The selected row (background)",
      "dark": "#33467C",
      "light": "#BCCDEE",
      "terminal": "reverse"
    }
  },
  "surface": {
    "paper": {
      "use": "Page background",
      "dark": "#1A1B26",
      "light": "#F4F6FB"
    },
    "sheet": {
      "use": "Raised panels and cards",
      "dark": "#16161E",
      "light": "#FFFFFF"
    },
    "rule": {
      "use": "Hairlines and borders",
      "dark": "#292E42",
      "light": "#DDE2EE"
    },
    "accent-soft": {
      "use": "Inline code, shipped tags",
      "dark": "#1F2A48",
      "light": "#E6EBFA"
    },
    "waiting-soft": {
      "use": "Callouts, planned tags",
      "dark": "#3A2A1F",
      "light": "#FFEFE2"
    },
    "term": {
      "use": "Terminal mockups",
      "dark": "#13141C",
      "light": "#1A1B26"
    },
    "term-bar": {
      "use": "Terminal status and key bars",
      "dark": "#101118",
      "light": "#16161E"
    },
    "term-edge": {
      "use": "Pane borders inside mockups",
      "dark": "#292E42",
      "light": "#292E42"
    }
  },
  "font": {
    "display": {
      "use": "Headings",
      "stack": "\"Bricolage Grotesque\", system-ui, sans-serif"
    },
    "body": {
      "use": "Prose",
      "stack": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "use": "Commands, labels, terminal mockups",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "header": {
    "height": "56px",
    "compact-height": "48px",
    "compact-max-width": "479px",
    "padding-inline": "clamp(12px, 1.4vw, 20px)",
    "gap": "12px",
    "mark-size": "12px",
    "mark-line-height": "1",
    "mark-weight": "600",
    "wordmark-size": "14px",
    "wordmark-line-height": "1.2",
    "wordmark-weight": "600",
    "title-size": "16px",
    "title-line-height": "1.2",
    "title-weight": "600",
    "action-size": "13px",
    "action-line-height": "1.2",
    "action-weight": "400",
    "icon-size": "18px",
    "icon-stroke": "1.75"
  },
  "breakpoint": {
    "sm": {
      "use": "Narrow terminal: the smallest width a view must fit",
      "cells": 80
    },
    "md": {
      "use": "Medium terminal: a second optional step appears",
      "cells": 100
    },
    "lg": {
      "use": "Wide terminal: every optional part is shown",
      "cells": 140
    }
  },
  "mark": {
    "●": "running or active",
    "○": "offline or ended",
    "◌": "bound to a pane, no agent running",
    "◆": "waits on your decision",
    "!": "warning",
    "✗": "failed or blocked",
    "✓": "done",
    "◐": "in review, waiting on someone else (board only)",
    "↻": "leads a resume action, never a row's state",
    "✎": "an annotation you sent (board only)",
    "‹ ›": "tabs off the end of a line (board only)",
    "▸": "a folded Squad board pane (board only)",
    "▾": "an open foldable pane in a toggle hint (board only)",
    "~": "approximate observed token total from incomplete coverage (board only)",
    "▁▂▃▄▅▆▇█": "completed-request trend: ▁ measured zero, ▂–█ relative totals, blank no data (board only)"
  },
  "browser": {
    "color": {
      "text": {
        "dark": "#B0B0B0",
        "light": "#343434"
      },
      "secondary": {
        "dark": "#B0B0B0",
        "light": "#626262"
      },
      "selected-text": {
        "dark": "#D8D8D8",
        "light": "#202020"
      },
      "disabled-text": {
        "dark": "#858585",
        "light": "#626262"
      },
      "focus": {
        "dark": "#B0B0B0",
        "light": "#626262"
      },
      "edge": {
        "dark": "#7D7D7D",
        "light": "#626262"
      },
      "working": {
        "dark": "#9ECE6A",
        "light": "#386000"
      },
      "waiting": {
        "dark": "#FF9E64",
        "light": "#964500"
      },
      "review": {
        "dark": "#BB9AF7",
        "light": "#7847BD"
      },
      "blocked": {
        "dark": "#F7768E",
        "light": "#B62C3B"
      },
      "link": {
        "dark": "#7DCFFF",
        "light": "#006B8F"
      }
    },
    "surface": {
      "paper": {
        "dark": "#080808",
        "light": "#FAFAFA"
      },
      "sheet": {
        "dark": "#101010",
        "light": "#FFFFFF"
      },
      "selection": {
        "dark": "#2B2B2B",
        "light": "#E2E2E2"
      },
      "disabled": {
        "dark": "#171717",
        "light": "#EAEAEA"
      },
      "rule": {
        "dark": "#303030",
        "light": "#D0D0D0"
      }
    },
    "metric": {
      "rule-width": "1px",
      "radius": "0",
      "notice-border-width": "1px",
      "notice-padding": "clamp(24px, 5vw, 44px)",
      "notice-heading-line-height": "1.15",
      "notice-heading-gap": "16px",
      "notice-mark-gap": "12px",
      "eyebrow-size": "11px",
      "eyebrow-weight": "600",
      "eyebrow-tracking": "0.09em",
      "eyebrow-gap": "8px",
      "caption-size": "11px",
      "caption-line-height": "1.2",
      "action-border-width": "1px",
      "focus-width": "2px",
      "field-border-width": "1px",
      "toggle-gap": "8px",
      "toggle-indicator-size": "14px",
      "toggle-indicator-border-width": "2px"
    }
  }
}
