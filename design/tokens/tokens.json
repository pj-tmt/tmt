{
  "$comment": "The tmt design tokens. Terminal renderings are the ANSI names the CLI uses (tmt-cli-style palette); web renderings are the light and dark values. Terminal mockups on the site always use the dark values, as the default tmt theme does.",
  "color": {
    "text": { "use": "Normal text", "dark": "#C0CAF5", "light": "#343B58", "terminal": "default" },
    "muted": {
      "use": "Labels and headers",
      "dark": "#9AA5CE",
      "light": "#5A6390",
      "terminal": "white"
    },
    "dim": {
      "use": "Secondary text, borders, empty values",
      "dark": "#7A83AE",
      "light": "#68709A",
      "terminal": "dim"
    },
    "accent": {
      "use": "Focus, the selected tab, keys and links in prose",
      "dark": "#7AA2F7",
      "light": "#1F5FBF",
      "terminal": "blue"
    },
    "waiting": {
      "use": "◆ waiting on you, anything that needs attention",
      "dark": "#FF9E64",
      "light": "#965027",
      "terminal": "yellow"
    },
    "working": {
      "use": "A member at work, success ✓",
      "dark": "#9ECE6A",
      "light": "#4F6A33",
      "terminal": "green"
    },
    "review": {
      "use": "In review, waiting on someone else; the Claude Code driver",
      "dark": "#BB9AF7",
      "light": "#7847BD",
      "terminal": "magenta"
    },
    "blocked": {
      "use": "Blocked, failed, errors",
      "dark": "#F7768E",
      "light": "#B62C3B",
      "terminal": "red"
    },
    "link": {
      "use": "Links you can open; the Codex driver",
      "dark": "#7DCFFF",
      "light": "#006B8F",
      "terminal": "cyan"
    },
    "selection": {
      "use": "The selected row (background)",
      "dark": "#283457",
      "light": "#D5E0F5",
      "terminal": "reverse"
    }
  },
  "surface": {
    "paper": { "use": "Page background", "dark": "#1A1B26", "light": "#F4F6FB" },
    "sheet": { "use": "Raised panels and cards", "dark": "#16161E", "light": "#FFFFFF" },
    "rule": { "use": "Hairlines and borders", "dark": "#292E42", "light": "#DDE2EE" },
    "accent-soft": { "use": "Inline code, shipped tags", "dark": "#1F2A48", "light": "#E6EBFA" },
    "waiting-soft": { "use": "Callouts, planned tags", "dark": "#3A2A1F", "light": "#FFEFE2" },
    "term": { "use": "Terminal mockups", "dark": "#13141C", "light": "#1A1B26" },
    "term-bar": { "use": "Terminal status and key bars", "dark": "#101118", "light": "#16161E" },
    "term-edge": { "use": "Pane borders inside mockups", "dark": "#292E42", "light": "#292E42" }
  },
  "font": {
    "display": { "use": "Headings", "stack": "\"Bricolage Grotesque\", system-ui, sans-serif" },
    "body": {
      "use": "Prose",
      "stack": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "use": "Commands, labels, terminal mockups",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "mark": {
    "●": "running or active",
    "○": "offline or ended",
    "◌": "bound to a pane, no agent running",
    "◆": "waits on your decision",
    "!": "warning",
    "✗": "failed or blocked",
    "✓": "done",
    "◐": "in review, waiting on someone else (board only)",
    "↻": "leads a resume action, never a row's state",
    "✎": "an annotation you sent (board only)",
    "‹ ›": "tabs off the end of a line (board only)",
    "▸": "a folded Squad board pane (board only)",
    "▾": "an open foldable pane in a toggle hint (board only)",
    "≥": "lower bound from missing member token coverage (board only)",
    "▁▂▃▄▅▆▇█": "completed-request trend: ▁ measured zero, ▂–█ relative rate, blank no data (board only)"
  }
}
