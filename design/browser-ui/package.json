{
  "name": "@tmt/browser-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./static.css": "./generated/static.css",
    "./static": "./src/static.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-static-css.mjs --write",
    "check:generated": "node scripts/generate-static-css.mjs --check",
    "check": "pnpm check:generated && tsc --noEmit && vp lint --config vitest.config.ts --deny-warnings --react-plugin src test && vp fmt --config vitest.config.ts --check .",
    "test": "vp test run --config vitest.config.ts"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "lucide-react": "1.52.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^25.0.3",
    "typescript": "^5.3.0",
    "vite-plus": "1.0.0"
  }
}
