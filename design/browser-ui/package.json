{
  "name": "@tmt/browser-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./static.css": "./generated/static.css",
    "./static": "./src/static.ts",
    "./busy-mark": "./src/busy-mark-gate.ts",
    "./shell": "./src/shell.ts",
    "./shell-host": "./src/shell-host.ts",
    "./react": "./src/react.ts",
    "./ui": "./src/ui/index.ts",
    "./ui.css": "./generated/ui.css",
    "./theme": "./src/theme.ts",
    "./gallery/frames": "./gallery/frames.tsx",
    "./test-fixtures/*": "./test/fixtures/*"
  },
  "scripts": {
    "generate": "node scripts/generate-static-css.mjs --write && node scripts/generate-ui-css.mjs --write && node scripts/generate-brand.mjs --write",
    "check:generated": "node scripts/generate-static-css.mjs --check && node scripts/generate-ui-css.mjs --check && node scripts/generate-brand.mjs --check",
    "check": "pnpm check:generated && tsc --noEmit && vp lint --config vitest.config.ts --deny-warnings --react-plugin src test gallery scripts/generate-ui-css.mjs scripts/ui-source-policy.mjs && vp fmt --config vitest.config.ts --check .",
    "test": "vp test run --config vitest.config.ts",
    "gallery": "vp dev --config vite.gallery.config.ts"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "lucide-react": "1.52.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^25.0.3",
    "typescript": "^5.3.0",
    "vite-plus": "1.0.0",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "class-variance-authority": "0.7.1"
  }
}
