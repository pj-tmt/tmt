{
  "name": "native",
  "targets": {
    "build-cli": {
      "command": "cargo build --locked -p tmt-cli",
      "options": {
        "cwd": "rust"
      },
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/extensions/tmt-office/rust/**/*",
        "{workspaceRoot}/extensions/tmt-squad/rust/**/*",
        "{workspaceRoot}/contracts/**/*",
        "{workspaceRoot}/skills/**/*",
        "{workspaceRoot}/extensions/tmt-office/contracts/**/*",
        "{workspaceRoot}/extensions/tmt-office/skills/**/*"
      ],
      "cache": false
    },
    "test": {
      "command": "cargo test --locked --workspace",
      "options": {
        "cwd": "rust"
      },
      "cache": false
    },
    "tmt": {
      "command": "sh ./scripts/tmt-dev.sh",
      "options": {
        "cwd": "."
      },
      "cache": false
    },
    "embedded-office-build": {
      "command": "TMT_OFFICE_SPA_DIR=\"$PWD/../target/office-spa\" CARGO_PROFILE_DEV_DEBUG=0 cargo build --locked -p tmt-office --features local-service",
      "options": {
        "cwd": "rust"
      },
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/extensions/tmt-office/rust/**/*",
        "{workspaceRoot}/extensions/tmt-squad/rust/**/*",
        "{workspaceRoot}/contracts/**/*",
        "{workspaceRoot}/skills/**/*",
        "{workspaceRoot}/extensions/tmt-office/contracts/**/*",
        "{workspaceRoot}/extensions/tmt-office/skills/**/*",
        "{workspaceRoot}/target/office-spa/**/*"
      ],
      "dependsOn": [
        {
          "projects": [
            "office-spa"
          ],
          "target": "build-local"
        }
      ],
      "cache": false
    }
  }
}
